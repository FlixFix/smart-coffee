PORT=3001
PICO_IP=192.168.178.88
PICO_PORT=80
MQTT_BROKER_IP=192.168.178.86
MQTT_BROKER_PORT=1883
MQTT_TOPIC=pico_log

# MQTT broker credentials - required if the broker needs authentication
# (the Home Assistant Mosquitto add-on does by default). Leave empty for an open broker.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=coffee-hub-backend

# Home Assistant bridge
# Base topic for state and commands published by this backend.
MQTT_BASE_TOPIC=coffee-hub
# Must match Home Assistant's MQTT discovery prefix (default: homeassistant).
HA_DISCOVERY_PREFIX=homeassistant
# How often the pico is polled for state, in milliseconds. Each cycle costs the pico a blocking
# temperature conversion on the same event loop that runs the PID - don't go much below 10000.
HA_STATE_INTERVAL_MS=10000
